# Local Vite (optional). Leave VITE_API_BASE_URL empty to use the /chat proxy in vite.config.ts
# (defaults to hosted Railway API). For a local FastAPI backend instead:
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
# VITE_API_BASE_URL=

# Production (Vercel): set in Project → Settings → Environment Variables
# VITE_API_BASE_URL=https://your-api.up.railway.app
