# Groq LLM (required for answer generation)
GROQ_API_KEY=
# Free-tier style limits example (gpt-oss-120b): 30 RPM, 1K RPD, 8K TPM, 200K TPD
GROQ_MODEL=openai/gpt-oss-120b
# Min tokens/call: low reasoning + 256 completion (CoT + ≤3 FAQ sentences). Cap input via CONTEXT_*.
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=256
GROQ_CONTEXT_CHUNKS=3
GROQ_CONTEXT_CHARS=480

# Optional paths (defaults match Architecture §15)
# CORPUS_DIR=docs/corpus
# CHROMA_DIR=data/chroma
